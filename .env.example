# Database (Vercel Postgres / Neon) - required
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Auth.js - required. Generate a secret with: openssl rand -base64 33
AUTH_SECRET=

# RTM users now register at /register (each advisor has their own login stored
# in the DB), so ADMIN_EMAIL / ADMIN_PASSWORD_HASH are no longer used.
# Optional: set a shared registration code to gate who can sign up.
REGISTRATION_CODE=

# Legacy single-admin login (unused now that /register exists).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=

# Anthropic (marketing content generation: posts + emails) - required only
# for the marketing pipeline. NOT needed for the RTM daily news tool.
ANTHROPIC_API_KEY=
ANTHROPIC_CONTENT_MODEL=claude-sonnet-5

# Google Gemini (RTM daily news briefs). Each registered advisor supplies their
# OWN key at signup (runs on their own free quota). This env var is only an
# optional shared fallback. Free tier, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Resend (email sending) - required for the email pipeline
RESEND_API_KEY=
RESEND_FROM_EMAIL="Tico <marketing@yourdomain.com>"

# Meta Graph API (Facebook + Instagram publishing) - required for the social pipeline
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=

# Vercel Blob (image uploads for Instagram posts) - required to publish to Instagram
BLOB_READ_WRITE_TOKEN=

# Vercel Cron auth - required, any random string, Vercel sends it back as
# "Authorization: Bearer <value>" when it calls /api/cron/generate-content
CRON_SECRET=

# Public app URL - required for unsubscribe links in emails
APP_URL=https://your-app.vercel.app

# RTM (daily news briefs) JSON API - optional, only needed to call
# /api/rtm/briefs from outside the admin panel (e.g. an automation tool)
RTM_API_SECRET=

# Optional
BUSINESS_NAME="שם העסק שלך"
POSTS_PER_WEEK=2
