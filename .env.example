# Database (Vercel Postgres / Neon) - required
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Auth.js - required. Generate a secret with: openssl rand -base64 33
AUTH_SECRET=

# Single admin login for the /admin dashboard - required
ADMIN_EMAIL=you@example.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=

# Anthropic (content generation) - required
ANTHROPIC_API_KEY=
ANTHROPIC_CONTENT_MODEL=claude-sonnet-5

# Resend (email sending) - required for the email pipeline
RESEND_API_KEY=
RESEND_FROM_EMAIL="Tico <marketing@yourdomain.com>"

# Meta Graph API (Facebook + Instagram publishing) - required for the social pipeline
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=

# Vercel Blob (image uploads for Instagram posts) - required to publish to Instagram
BLOB_READ_WRITE_TOKEN=

# Vercel Cron auth - required, any random string, Vercel sends it back as
# "Authorization: Bearer <value>" when it calls /api/cron/generate-content
CRON_SECRET=

# Public app URL - required for unsubscribe links in emails
APP_URL=https://your-app.vercel.app

# RTM (daily news briefs) JSON API - optional, only needed to call
# /api/rtm/briefs from outside the admin panel (e.g. an automation tool)
RTM_API_SECRET=

# Optional
BUSINESS_NAME="שם העסק שלך"
POSTS_PER_WEEK=2
